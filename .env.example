# Copy to .env (which is not checked in). The snapshotter and the runner read it when they start;
# a variable already set in the shell wins over the file.
# forge does not read this file: for the deploy script, load it into the shell first with
#   set -a; source .env; set +a

# Archive RPC used for snapshots and deploys (the public endpoint is the default in config/mainnet.json)
RPC_HYDRATION=https://rpc.hydradx.cloud

# The runner (src/bot.ts)
# Date of the very first epoch, e.g. 2027-01-15. Required.
FIRST_EPOCH=
# Optional: program file, data folder and seconds between passes. These are the defaults.
# PROGRAM=programs/htoken-no-hollar-borrowers.yaml
# DATA_DIR=data
# BOT_INTERVAL_SECONDS=60

# Deploying the distributor (contracts/script/DeployRewardsDistributor.s.sol)
URD_OWNER=
URD_UPDATER=
URD_TIMELOCK=43200
