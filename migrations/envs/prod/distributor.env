# An RPC_HYDRATION already set in the shell or in .env is kept.
RPC_HYDRATION=${RPC_HYDRATION:-https://rpc.hydradx.cloud}

# The rewards multisig, which owns the distributor. Required.
URD_OWNER=
# Empty: one transaction, the multisig owns the distributor from its first block and adds the
# root-posting key itself with setRootUpdater. With a key here the deployer owns it for two
# transactions first (README, "Deploying the distributor").
URD_UPDATER=
# Seconds between a root being posted and becoming claimable. Shorter than a day.
URD_TIMELOCK=43200
