# Start the Hydration fork first:
#   npm run fork:hydration

RPC_HYDRATION=http://127.0.0.1:8547

# Stands in for the rewards multisig: anvil's second account.
URD_OWNER=0x70997970C51812dc3A010C7d01b50d7D74dc79C8
# Stands in for the root-posting address: anvil's third account. The deployer adds it and hands the
# distributor to the owner (three transactions). Empty rehearses the single transaction, where the
# owner adds the address itself.
URD_UPDATER=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
URD_TIMELOCK=43200
