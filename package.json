{
  "name": "hydration-rewards",
  "version": "0.1.0",
  "private": true,
  "description": "Rule-based reward programs for Hydration: hourly snapshots, daily epochs, claims through Morpho's Universal Rewards Distributor",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "npm run test:ts && npm run test:sol",
    "test:ts": "node --test \"test/*.test.ts\"",
    "test:sol": "node tools/check-pin.ts && forge test --root contracts",
    "lint": "prettier --check . && tsc -p tsconfig.json",
    "format": "prettier --write .",
    "check-pin": "node tools/check-pin.ts",
    "fixtures": "node tools/make-fixtures.ts",
    "snapshot": "node src/snapshot.ts",
    "close-epoch": "node src/close-epoch.ts",
    "preview": "node src/preview.ts",
    "bot": "node src/bot.ts"
  },
  "dependencies": {
    "@openzeppelin/merkle-tree": "1.0.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
